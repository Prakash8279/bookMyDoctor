# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr

# Env files (repo root .gitignore already covers these, but listing them here too means this
# rule survives even if client/ is ever split into its own repo).
.env
.env.*
*.local

# .env.example is a committed template with no real secrets (see its own header
# comment) — explicitly un-ignore it despite the broad .env.* rule above.
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
