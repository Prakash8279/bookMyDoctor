# Copy this file to .env (local dev with `npm run dev`) and fill in real values.
# For the Docker build, this is passed as a build ARG instead (see ../docker-compose.yml's
# `client` service and Dockerfile's header comment) — Vite bakes VITE_* vars in at build time,
# so this file only matters for `npm run dev` / `vite build` run directly on your machine.

VITE_API_BASE_URL=http://localhost:4000
