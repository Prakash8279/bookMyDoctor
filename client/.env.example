# Copy this file to .env (local dev with `npm run dev`) and fill in real values.
# For the Docker build, this is passed as a build ARG instead (see ../docker-compose.yml's
# `client` service and Dockerfile's header comment) — Vite bakes VITE_* vars in at build time,
# so this file only matters for `npm run dev` / `vite build` run directly on your machine.

VITE_API_BASE_URL=http://localhost:4000

# "Continue with Google" on the login/register pages (src/lib/googleSignIn.js). Leave blank to
# keep the button showing a clean "not configured yet" error — email/password auth is completely
# unaffected. Must be the SAME Client ID as the backend's GOOGLE_CLIENT_ID
# (server/server/.env) — see that file's comment for the full step-by-step to create one. This is
# a public identifier (it's meant to ship inside frontend code), not a secret.
VITE_GOOGLE_CLIENT_ID=
