# Flutter/Dart build artifacts and tool-managed files.
# Android is a supported platform in this repository. iOS project files have
# not been added yet; keep its generated/local files ignored when they are.

.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/
*.iml

# Platform-local/generated files. Signing keys and their properties are kept
# separately under android/.gitignore and must never be committed.
android/local.properties
android/**/build/
ios/Flutter/
ios/Pods/
