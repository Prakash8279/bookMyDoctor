<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow breakpoints, hot reload, and other development features. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Local emulator/LAN development can use HTTP. Production keeps the
         main manifest's false value, while tools:replace makes this debug-only
         override explicit to the Android manifest merger. -->
    <application
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic" />
</manifest>
