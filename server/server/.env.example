# Copy this file to .env and fill in real values. Never commit .env.

# --- Server ---
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Exact number of reverse-proxy hops (nginx, load balancer, CDN, etc.) in front of this
# process. Passed to Express's `trust proxy` so req.ip is the real client address, which the
# IP-keyed rate limiters (authLimiter, defaultLimiter) rely on. Use 1 for a single reverse
# proxy/load balancer (the common case); increase if there's an extra hop (e.g. a CDN in
# front of the load balancer). Never set this to a truthy non-numeric value in production —
# trusting the whole X-Forwarded-For chain lets a client forge req.ip on every request.
TRUST_PROXY_HOPS=1

# --- PostgreSQL ---
# Prisma connection string. Example for local dev:
DATABASE_URL="postgresql://doctor_connect:changeme@localhost:5432/doctor_connect?schema=public"
# Prisma connection-pool cap for THIS process (config/db.js appends it to DATABASE_URL as
# connection_limit, unless DATABASE_URL already sets one itself). This app runs multiple API
# replicas plus a separate worker process, and each one opens its own pool — left uncapped,
# replica count alone can exhaust a managed Postgres's connection limit with no increase in
# real traffic. Size this so (replica count + worker count) * DB_POOL_SIZE stays under your
# Postgres plan's max connections.
DB_POOL_SIZE=5
# Seconds Prisma will wait for a free connection from the pool before failing fast (appended as
# pool_timeout, same not-already-set guard as DB_POOL_SIZE above).
DB_POOL_TIMEOUT_SECONDS=10

# --- Redis (cache, distributed locks, BullMQ, rate-limit store) ---
REDIS_URL="redis://localhost:6379"

# --- JWT ---
# Generate strong random secrets, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string
JWT_REFRESH_SECRET=replace_me_with_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# Optional: set these to the OLD secret value when rotating JWT_ACCESS_SECRET/JWT_REFRESH_SECRET,
# so tokens already signed under the old secret keep verifying for one deploy cycle instead of
# every logged-in user being instantly force-logged-out. Leave unset in normal operation. To
# rotate: move the current secret here, generate a new JWT_ACCESS_SECRET/JWT_REFRESH_SECRET,
# deploy, then remove these once you're confident nothing still relies on the old secret.
JWT_ACCESS_SECRET_PREVIOUS=
JWT_REFRESH_SECRET_PREVIOUS=

# --- Password hashing ---
BCRYPT_SALT_ROUNDS=12

# --- File uploads (local disk in dev; swap for S3-compatible config in prod) ---
UPLOAD_DIR=./uploads
UPLOAD_BASE_URL=http://localhost:4000/uploads

# --- Rate limiting ---
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
DEFAULT_RATE_LIMIT_MAX=300
DEFAULT_RATE_LIMIT_WINDOW_MINUTES=1
# Booking write path (appointment creation, walk-in registration). The limiter itself
# (bookingLimiter) is exported from middleware/rateLimiter.js now; it's wired into routes
# starting with the appointments module.
BOOKING_RATE_LIMIT_MAX=20
BOOKING_RATE_LIMIT_WINDOW_MINUTES=1
# Payment write path (recording a payment against an appointment, or a standalone/walk-in
# payment). The limiter itself (paymentLimiter) is exported from middleware/rateLimiter.js;
# it's wired into routes in the payments module.
PAYMENT_RATE_LIMIT_MAX=20
PAYMENT_RATE_LIMIT_WINDOW_MINUTES=1

# --- Admin API ---
# Optional comma-separated list of exact IPs allowed to reach the admin API (system settings,
# booking rules, activity log, dashboard stats — see middleware/adminIpAllowlist.js). No CIDR
# support, plain string match against req.ip. Leave empty/unset to keep the current behavior of
# no IP restriction (access is still gated by authenticate + authorize('admin', 'superadmin') as
# before) — only set this if you want to additionally lock the admin API down to a known office/
# VPN egress IP. Example: ADMIN_IP_ALLOWLIST=203.0.113.10,203.0.113.11
ADMIN_IP_ALLOWLIST=

# --- Payments (Razorpay) ---
# Powers the patient-facing "Pay now" button shown right after a booking is confirmed
# (modules/payments/razorpay.service.js). Leave both blank to keep online payments disabled —
# patients then only see "pay at clinic", nothing breaks.
# Get free TEST MODE keys (no real bank account needed): sign up at
# https://dashboard.razorpay.com/signup -> Settings -> API Keys -> "Generate Test Key".
# Never commit real keys; RAZORPAY_KEY_SECRET must be treated like a password.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Reconciliation webhook (production-readiness plan, Phase 2.3) — closes a gap where a payment
# genuinely succeeds on Razorpay's side but the patient's browser never comes back to call our
# own /payments/razorpay/verify endpoint (tab closed, network drop, app crash right after paying),
# leaving that appointment stuck at "pending_payment" forever. A SEPARATE secret from
# RAZORPAY_KEY_SECRET above — generated when you add the webhook itself, not from the API Keys
# page. Leave blank to keep the webhook route rejecting every call (no reconciliation, but nothing
# else is affected — the normal "Pay now" flow above does not need this at all).
# To set up: Razorpay Dashboard -> Settings -> Webhooks -> Add New Webhook.
#   Webhook URL: https://<your-deployed-api-domain>/payments/webhook/razorpay
#   Active events: check "payment.captured" (that's the only one this app currently reconciles on).
#   Razorpay then shows you a Webhook Secret ONCE — copy it here immediately.
RAZORPAY_WEBHOOK_SECRET=

# --- Google Sign-In ("Continue with Google" on the login/register pages) ---
# Leave blank to keep Google sign-in disabled — the button then shows a clean "not configured
# yet" error and email/password auth is completely unaffected.
# To enable:
#   1. Go to https://console.cloud.google.com/apis/credentials (create/select a project first).
#   2. Configure the OAuth consent screen if prompted (External, add your own email as a test
#      user while it's not yet published — that's enough for development).
#   3. Create Credentials -> OAuth client ID -> Application type: "Web application".
#   4. Under "Authorized JavaScript origins" add every URL the frontend runs on, e.g.
#      http://localhost:5173 for local dev, plus your real deployed domain later. No redirect
#      URI is needed — Google Identity Services posts the sign-in result straight to client-side
#      JS, it never redirects through the backend.
#   5. Copy the Client ID it gives you (looks like 123456789-abc...xyz.apps.googleusercontent.com)
#      here AND into client/.env's VITE_GOOGLE_CLIENT_ID — same value in both places. This is a
#      public identifier, not a secret (it's meant to be visible inside frontend code), so it's
#      safe to paste directly, unlike RAZORPAY_KEY_SECRET above.
GOOGLE_CLIENT_ID=

# --- Bank-detail field encryption (doctor payout details) ---
# Encrypts bankAccountHolderName/bankAccountNumber/bankIfscCode/bankName/bankUpiId at rest
# (services/encryptionService.js, AES-256-GCM) instead of storing them as plain text in
# doctor_profiles. Leave blank to keep this feature disabled — a doctor trying to save/edit bank
# details then gets a clean "not configured yet" error; every other feature is unaffected.
# Generate your OWN random 32-byte key, as a 64-character hex string, YOURSELF — never ask an
# assistant/AI tool to generate or fill this in for you, and never commit the real value:
#   openssl rand -hex 32
# If you rotate this key later, every row already encrypted under the OLD key becomes
# undecryptable until re-encrypted — there is no key-rotation migration script (yet).
BANK_DETAILS_ENCRYPTION_KEY=

# --- Backend error tracking (Sentry) ---
# Optional (production-readiness plan, Phase 3 — "no visibility into production errors beyond
# application logs"). See src/config/sentry.js. Leave blank to keep this disabled — every log
# still writes to config/logger.js as before, this only ALSO forwards unexpected exceptions and
# 5xx errors to Sentry for alerting/aggregation. Also requires the @sentry/node package actually
# be installed (npm install) — added to package.json, but you still need to run the install
# yourself; until then, a set DSN just logs one startup warning and stays disabled.
# Get a DSN: https://sentry.io -> create a project (platform: Node/Express) -> Settings -> Client Keys (DSN).
SENTRY_DSN=

# --- Web refresh-token cookie (httpOnly, web app only — mobile is unaffected) ---
# See src/utils/webClientAuth.js for the full explanation. Leave blank for the default ('lax'),
# which is correct for almost every deployment, including this repo's own docker-compose setup
# (different ports, same "localhost") and a normal same-domain-family deployment (app.example.com
# + api.example.com). Only set this to "none" if the web frontend and the API end up on two
# completely unrelated top-level domains — and read webClientAuth.js's comment first, since that
# also gives up a CSRF protection 'lax' provides for free.
REFRESH_COOKIE_SAME_SITE=
