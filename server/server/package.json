{
  "name": "doctor-connect-server",
  "version": "1.0.0",
  "description": "BookMyDoctor24 backend API — Node.js + Express + PostgreSQL (Prisma) + Redis",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "cross-env UV_THREADPOOL_SIZE=16 nodemon src/server.js",
    "start": "cross-env UV_THREADPOOL_SIZE=16 node src/server.js",
    "start:cluster": "cross-env UV_THREADPOOL_SIZE=16 node src/cluster.js",
    "worker": "node src/jobs/worker.process.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "node prisma/seed.js",
    "encrypt-bank-details": "node scripts/encryptExistingBankDetails.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint ."
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "@sentry/node": "^8.42.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.12.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.0.12",
    "rate-limit-redis": "^4.2.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.14.2"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "eslint": "^9.38.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "prisma": "^5.20.0",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
